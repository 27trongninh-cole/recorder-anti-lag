<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái quyền: đang kiểm tra..."
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnRequestPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Cấp quyền hiển thị trên ứng dụng khác" />

    <Button
        android:id="@+id/btnBatteryOptimization"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="2. Bỏ giới hạn pin (nền)" />

    <Button
        android:id="@+id/btnStartOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="3. BẬT overlay test" />

    <Button
        android:id="@+id/btnStopOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="TẮT overlay" />

    <Button
        android:id="@+id/btnStartProjection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="4. Bắt đầu ghi hình (buffer)" />

    <EditText
        android:id="@+id/inputSeconds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Số giây N muốn cắt (mặc định 15)"
        android:inputType="number"
        android:text="15" />

    <Button
        android:id="@+id/btnSimulateCapture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="5. Giả lập bắt khoảnh khắc -> Cắt N giây" />

    <Button
        android:id="@+id/btnStopProjection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Dừng ghi hình" />

    <TextView
        android:id="@+id/projectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="13sp"
        android:text="Ghi hình: chưa bắt đầu" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="13sp"
        android:textColor="#666666"
        android:text="Bước 4: bấm 'Bắt đầu ghi hình', chọn Entire screen. Vào game chơi vài chục giây. Bước 5: bấm 'Giả lập bắt khoảnh khắc' bất kỳ lúc nào — app sẽ cắt đúng N giây gần nhất thành file MP4 trong bộ nhớ app (Movies). Kiểm tra file bằng ứng dụng quản lý file, xem có mượt không, có đúng N giây không, có bị giật khi chơi game trong lúc ghi không." />

</LinearLayout>
