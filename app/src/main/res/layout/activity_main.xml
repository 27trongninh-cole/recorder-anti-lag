<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái quyền: đang kiểm tra..."
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnRequestPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Cấp quyền hiển thị trên ứng dụng khác" />

    <Button
        android:id="@+id/btnBatteryOptimization"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="2. Bỏ giới hạn pin (nền)" />

    <Button
        android:id="@+id/btnStartOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="3. BẬT overlay test" />

    <Button
        android:id="@+id/btnStopOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="TẮT overlay" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textStyle="bold"
        android:text="Chọn tướng đang chơi (test avatar):" />

    <LinearLayout
        android:id="@+id/heroButtonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/selectedHeroText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:text="Chưa chọn tướng nào" />

    <Button
        android:id="@+id/btnStartProjection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="4. Bắt đầu ghi hình + phát hiện tự động" />

    <EditText
        android:id="@+id/inputSeconds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Số giây N muốn cắt (mặc định 15)"
        android:inputType="number"
        android:text="15" />

    <Button
        android:id="@+id/btnSimulateCapture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="5. Giả lập bắt khoảnh khắc -> Cắt N giây" />

    <Button
        android:id="@+id/btnStopProjection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Dừng ghi hình" />

    <TextView
        android:id="@+id/projectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="13sp"
        android:text="Ghi hình: chưa bắt đầu" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textStyle="bold"
        android:text="Log phát hiện (audio + OCR + avatar):" />

    <Button
        android:id="@+id/btnCopyLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Copy toàn bộ log" />

    <TextView
        android:id="@+id/detectionLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:textIsSelectable="true"
        android:fontFamily="monospace"
        android:text="(chưa có log nào)" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="13sp"
        android:textColor="#666666"
        android:text="Bước: chọn tướng test ở trên, bấm 4 (chọn Entire screen), vào game chơi. Log phát hiện sẽ hiện realtime mỗi khi audio/OCR/avatar khớp gì đó, và tự động cắt clip khi đủ điều kiện. Bấm 5 để giả lập cắt thủ công bất kỳ lúc nào." />

</LinearLayout>
</ScrollView>
